MaterialDef Tiled {

    MaterialParameters {
        Texture2D ColorMap
        Texture2D ColorMap0
        Texture2D ColorMap1
        Texture2D ColorMap2
        Texture2D ColorMap3
        Texture2D DecalMap
        TextureArray ColorArray0
        TextureArray ColorArray1
        TextureArray ColorArray2
        TextureArray ColorArray3
        Color Color
        Color TransColor
        Boolean UseTintColor : true
        Color TintColor : 1.0 1.0 1.0 1.0
        Vector2 ImageSize
        Vector4 TileSize
        Vector2 DecalImageSize
        Vector4 DecalTileSize
        Vector4 Decal0
        Vector4 Decal1
        Vector4 Decal2
        Vector4 Decal3
        Float DecalFlipFlags : 0.0
        Boolean UseInstancing
        Boolean UseTilesetImage
        // for animation use
        Vector2 TilePosition
        Float Opacity : 1.0
        Float LayerOpacity : 1.0
        Boolean UseTileAlphaOcclusion : true
        Float TileAlphaOcclusionStrength : 0.30
        Float TileAlphaOcclusionRadius : 1.25
    }

    Technique {
        VertexShader GLSL310 GLSL300 GLSL100 GLSL150:   Shader/Tiled.vert
        FragmentShader GLSL310 GLSL300 GLSL100 GLSL150: Shader/Tiled.frag

        WorldParameters {
            WorldViewProjectionMatrix
            ViewProjectionMatrix
            ViewMatrix
        }

        RenderState {
            Blend Alpha
            FaceCull Off
        }

        Defines {
            HAS_COLOR_MAP : ColorMap
            HAS_COLOR_MAP0 : ColorMap0
            HAS_COLOR_MAP1 : ColorMap1
            HAS_COLOR_MAP2 : ColorMap2
            HAS_COLOR_MAP3 : ColorMap3
            HAS_DECAL_MAP : DecalMap
            HAS_COLOR_ARRAY0 : ColorArray0
            HAS_COLOR_ARRAY1 : ColorArray1
            HAS_COLOR_ARRAY2 : ColorArray2
            HAS_COLOR_ARRAY3 : ColorArray3
            HAS_COLOR : Color
            HAS_TRANS_COLOR: TransColor
            USE_TINT_COLOR: UseTintColor
            HAS_TINT_COLOR: TintColor
            USE_TILESET_IMAGE: UseTilesetImage
            INSTANCING: UseInstancing
            USE_TILE_POSITION: TilePosition
            HAS_OPACITY : Opacity
            HAS_LAYER_OPACITY : LayerOpacity
            USE_TILE_ALPHA_OCCLUSION : UseTileAlphaOcclusion
        }
    }

}
